            // Load marketplace
            async function loadMarketplace() {
                const marketList = document.getElementById('marketListItems');
                const statusElem = document.getElementById('marketStatus');
                const overlay = document.getElementById('loadingOverlay');
                overlay.style.display = 'flex';
                try {
                    if (!contract) throw new Error('Wallet not connected');
                    const listedFilter = contract.filters.DomainListed();
                    const soldFilter = contract.filters.DomainSold();
                    const listedEvents = await withTimeout(contract.queryFilter(listedFilter, 0, 'latest'));
                    const soldEvents = await withTimeout(contract.queryFilter(soldFilter, 0, 'latest'));
                    const soldTokenIds = new Set(soldEvents.map(e => e.args.tokenId.toString()));
                    const listedDomains = [];
                    for (const event of listedEvents) {
                        const tokenId = event.args.tokenId.toString();
                        if (!soldTokenIds.has(tokenId)) {
                            const price = await withTimeout(contract.tokenIdToPrice(tokenId));
                            if (price.gt(0)) {
                                const domainEntry = registeredDomains.find(d => d.tokenId === tokenId);
                                const name = domainEntry ? domainEntry.name : `domain${tokenId.slice(0, 8)}.vc`;
                                listedDomains.push({ name, price: price.toString(), tokenId });
                            }
                        }
                    }
                    marketList.innerHTML = listedDomains.length ? '' : '<p class="history-item">No domains listed for sale</p>';
