            // Load dashboard
            async function loadDashboard() {
                const domainList = document.getElementById('domainList');
                const statusElem = document.getElementById('status');
                const overlay = document.getElementById('loadingOverlay');
                overlay.style.display = 'flex';
                try {
                    if (!userAddress || !contract) {
                        domainList.innerHTML = '<p class="history-item">Connect wallet to view domains</p>';
                        overlay.style.display = 'none';
                        return;
                    }
                    const transferFilterTo = contract.filters.Transfer(null, userAddress);
                    const transferFilterFrom = contract.filters.Transfer(userAddress, null);
                    const [transfersTo, transfersFrom] = await Promise.all([
                        withTimeout(contract.queryFilter(transferFilterTo, 0, 'latest')),
                        withTimeout(contract.queryFilter(transferFilterFrom, 0, 'latest'))
                    ]);
                    const tokenIds = new Set();
                    transfersTo.forEach(event => tokenIds.add(event.args.tokenId.toString()));
                    transfersFrom.forEach(event => tokenIds.delete(event.args.tokenId.toString()));
                    const domains = [];
                    for (const tokenId of tokenIds) {
                        const owner = await withTimeout(contract.ownerOf(tokenId));
                        if (owner.toLowerCase() !== userAddress.toLowerCase()) continue;
                        const domainEntry = registeredDomains.find(d => d.tokenId === tokenId);
                        const name = domainEntry ? domainEntry.name : `domain${tokenId.slice(0, 8)}.vc`;
                        let expiry = await withTimeout(contract.nameToExpiry(name.replace('.vc', '')));
                        if (expiry.toNumber() === 0 && domainEntry) {
                            const block = await withTimeout(provider.getBlock(domainEntry.blockNumber));
                            const registrationPeriod = await withTimeout(contract.REGISTRATION_PERIOD());
                            expiry = ethers.BigNumber.from(block.timestamp).add(registrationPeriod);
                        }
                        const content = await withTimeout(contract.nameToContent(name.replace('.vc', '')));
                        domains.push({ name, expiry: expiry.toNumber(), content, tokenId });
                    }
                    domainList.innerHTML = domains.length ? '' : '<p class="history-item">No domains owned</p>';
                    domains.forEach(dom => {
                        const card = document.createElement('div');
                        card.className = 'domain-card';
                        const expiryDate = dom.expiry > 0 ? new Date(dom.expiry * 1000).toLocaleDateString() : 'Expired or invalid';
                        card.innerHTML = `
                            <h3>${dom.name}</h3>
                            <p>Expiry: ${expiryDate}</p>
                            <p>Content: ${dom.content || 'None'}</p>
                            <div>
                                <button onclick="renew('${dom.name.replace('.vc', '')}')"><i class="fas fa-sync"></i> Renew</button>
                                <button onclick="setAddr('${dom.name.replace('.vc', '')}')"><i class="fas fa-edit"></i> Set Address</button>
                                <button onclick="setContent('${dom.name.replace('.vc', '')}')"><i class="fas fa-file"></i> Set Content</button>
                                <button onclick="addSub('${dom.name.replace('.vc', '')}')"><i class="fas fa-plus-circle"></i> Add Subdomain</button>
                                <button onclick="listDomain('${dom.name.replace('.vc', '')}', '${dom.tokenId}')"><i class="fas fa-tag"></i> List for Sale</button>
                            </div>
                        `;
                        domainList.appendChild(card);
                    });
                } catch (error) {
                    domainList.innerHTML = `<p class="history-item">Error loading domains: ${parseError(error)}</p>`;
                    statusElem.textContent = `Dashboard load failed: ${parseError(error)}`;
                    console.error('Dashboard load error:', error);
                } finally {
                    overlay.style.display = 'none';
                }
            }

            // Load transaction history
            async function loadTransactionHistory() {
                const txHistory = document.getElementById('txHistory');
                const statusElem = document.getElementById('status');
                const overlay = document.getElementById('loadingOverlay');
                overlay.style.display = 'flex';
                try {
                    if (!contract) {
                        txHistory.innerHTML = '<p class="history-item">Connect wallet to view history</p>';
                        overlay.style.display = 'none';
                        return;
                    }
                    const filters = [
                        contract.filters.DomainRegistered(null, null, null),
                        contract.filters.DomainListed(null),
                        contract.filters.DomainSold(null, userAddress),
                        contract.filters.Transfer(null, userAddress),
                        contract.filters.Transfer(userAddress, null)
                    ];
                    const events = (await Promise.all(filters.map(f => withTimeout(contract.queryFilter(f, 0, 'latest')))))
                        .flat()
                        .filter(event => {
                            if (event.event === 'DomainRegistered') {
                                const domainEntry = registeredDomains.find(d => d.tokenId === event.args.tokenId.toString());
                                return domainEntry && domainEntry.owner.toLowerCase() === userAddress.toLowerCase();
                            }
                            return true;
                        })
                        .sort((a, b) => b.blockNumber - a.blockNumber)
                        .slice(0, 20);
                    txHistory.innerHTML = events.length ? '' : '<p class="history-item">No recent transactions</p>';
                    for (const event of events) {
                        const block = await withTimeout(provider.getBlock(event.blockNumber));
                        const date = new Date(block.timestamp * 1000).toLocaleString();
                        const card = document.createElement('div');
                        card.className = 'history-item';
                        let details = '';
                        const domainEntry = registeredDomains.find(d => d.tokenId === event.args.tokenId.toString());
                        const name = domainEntry ? domainEntry.name : `domain${event.args.tokenId.toString().slice(0, 8)}.vc`;
                        if (event.event === 'DomainRegistered') {
                            details = `Registered ${name} by ${event.args.owner.slice(0, 6)}...${event.args.owner.slice(-4)}`;
                        } else if (event.event === 'DomainListed') {
                            details = `Listed ${name} for ${ethers.utils.formatEther(event.args.price)} VC`;
                        } else if (event.event === 'DomainSold') {
                            details = `Sold ${name} to ${event.args.buyer.slice(0, 6)}...${event.args.buyer.slice(-4)} for ${ethers.utils.formatEther(event.args.price)} VC`;
                        } else if (event.event === 'Transfer') {
                            details = `Transferred ${name} from ${event.args.from.slice(0, 6)}...${event.args.from.slice(-4)} to ${event.args.to.slice(0, 6)}...${event.args.to.slice(-4)}`;
                        }
                        card.innerHTML = `<p>${date}: ${details}</p>`;
                        txHistory.appendChild(card);
                    }
                } catch (error) {
                    txHistory.innerHTML = `<p class="history-item">Error loading history: ${parseError(error)}</p>`;
                    statusElem.textContent = `Transaction history load failed: ${parseError(error)}`;
                    console.error('Transaction history load error:', error);
                } finally {
                    overlay.style.display = 'none';
                }
            }

            // List domain from dashboard
            window.listDomain = async (name, tokenId) => {
                document.getElementById('listDomain').value = name;
                document.getElementById('listPrice').value = '';
                document.getElementById('listBtn').scrollIntoView({ behavior: 'smooth' });
            };

            // Event listeners
            document.getElementById('connectWallet').addEventListener('click', () => connectWallet(true));
            document.getElementById('disconnectWallet').addEventListener('click', disconnectWallet);
            document.querySelector('.hamburger').addEventListener('click', () => {
                document.querySelector('nav').classList.toggle('active');
            });

            // Initialize wallet
            initializeWallet();
        });
    </script>
</body>
</html>
